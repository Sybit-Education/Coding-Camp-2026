{
  "name": "mettnau",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "check:service-boundaries": "node scripts/check-service-boundaries.mjs",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "npm run check:service-boundaries && oxlint . --deny-warnings",
    "lint:fix": "npm run check:service-boundaries && oxlint . --fix",
    "format": "oxfmt src/"
  },
  "dependencies": {
    "@lucide/vue": "^1.34.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "dompurify": "^3.4.14",
    "leaflet": "^1.9.4",
    "minisearch": "^7.2.0",
    "marked": "^18.0.11",
    "pinia": "^4.0.3",
    "pocketbase": "^0.28.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.65.0",
    "oxlint": "~1.80.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.19.0 || >=24.12.0"
  }
}
